{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user was created"
        }
      },
      "required": ["uid", "email"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Contact or advisory inquiry submitted through portfolio",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email",
          "maxLength": 150
        },
        "subject": {
          "type": "string",
          "description": "Subject of inquiry",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Message body",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        }
      },
      "required": ["name", "email", "subject", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Inquiries submitted via contact form"
    }
  }
}
